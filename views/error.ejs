        <h1 class="text-xl font-bold uppercase tracking-wider text-primary-600"><%= title %></h1>
        <p class="mt-3 text-sm text-slate-500 dark:text-slate-400"><%= message %></p>
        <a href="/" class="inline-flex mt-6 px-4 py-2 bg-primary-600 text-white text-xs font-mono uppercase rounded">Go Home</a>
