<%- include('partials/layout-start') %>

<section id="heroSection" class="pixel-hero relative min-h-[85vh] flex items-center justify-center py-20 px-4 border-b border-slate-200/60 dark:border-slate-800/60 bg-white dark:bg-slate-950 overflow-hidden">
    <div class="pixel-grid absolute inset-0 pointer-events-none"></div>
    <div class="streetlight" aria-hidden="true"><span></span></div>
    <div class="pixel-mascot" aria-hidden="true"><span></span></div>

    <div class="relative z-10 text-center px-4 max-w-3xl mx-auto">
        <div class="pixel-badge inline-flex items-center gap-2 px-3.5 py-1.5 rounded border border-primary-200 dark:border-primary-900 text-primary-600 text-xs font-mono uppercase tracking-wider mb-8 animate-fade-in-up">
            <span class="w-1.5 h-1.5 bg-primary-600 rounded-full animate-pulse"></span>
            Active
        </div>

        <h1 class="pixel-title text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-primary-600 mb-6 animate-fade-in-up delay-100 uppercase">Explore the Unknown</h1>
        <p class="pixel-subtitle text-base sm:text-lg text-slate-500 dark:text-slate-400 mb-12 max-w-xl mx-auto animate-fade-in-up delay-200 leading-relaxed font-light font-sans">Enter a location to unlock a retro world dossier with hidden history, local flavor, and practical travel intel.</p>

        <div class="animate-fade-in-up delay-300 space-y-6">
            <button id="scanLocationBtn" type="button" class="pixel-button group relative inline-flex items-center gap-2 px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded active:scale-[0.98] transition-all duration-200 cursor-pointer">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
                <span>Scan Geolocation</span>
            </button>

            <div class="flex items-center gap-4 max-w-xs mx-auto">
                <div class="flex-1 h-px bg-slate-200 dark:bg-slate-800"></div>
                <span class="text-slate-400 dark:text-slate-600 text-xs font-mono uppercase tracking-wider">or query</span>
                <div class="flex-1 h-px bg-slate-200 dark:bg-slate-800"></div>
            </div>

            <form id="manualForm" class="flex flex-col sm:flex-row items-stretch gap-3 max-w-lg mx-auto">
                <div class="flex-1 relative">
                    <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" /></svg>
                    <input id="locationInput" type="text" placeholder="City, landmark, or region..." class="w-full pl-11 pr-4 py-3 bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-700 rounded text-sm text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all" autocomplete="off">
                </div>
                <button id="generateBtn" type="submit" class="pixel-button px-5 py-3 bg-primary-600 hover:bg-primary-700 text-white text-sm font-semibold rounded transition-all duration-200 flex items-center gap-2 justify-center cursor-pointer">Analyze</button>
            </form>
        </div>
    </div>
    <div class="skyline-ticker" aria-hidden="true"><span>World feed: jungle canopy online - neon towers humming - old district lights flicker - village fireflies rising - mine lanterns active - tide strip moving</span></div>
    <div class="wave-strip" aria-hidden="true"></div>
</section>

<section id="loadingSection" class="hidden pixel-section py-24 px-4 bg-slate-50 dark:bg-slate-950">
    <div class="max-w-4xl mx-auto text-center">
        <div class="w-12 h-12 border-2 border-slate-300 dark:border-slate-700 border-t-primary-600 dark:border-t-primary-500 rounded-full animate-spin mx-auto mb-8"></div>
        <h2 class="pixel-heading text-xl font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-2" id="loadingTitle">Processing coordinates...</h2>
        <p class="text-sm font-mono text-slate-500 dark:text-slate-400" id="loadingMessage">Generating target data stream</p>
        <div class="mt-12 space-y-6 max-w-2xl mx-auto text-left opacity-60"><div class="skeleton h-8 w-1/3"></div><div class="skeleton h-4 w-1/4"></div><div class="space-y-2.5 mt-8"><div class="skeleton h-4 w-full"></div><div class="skeleton h-4 w-5/6"></div><div class="skeleton h-4.5 w-4/5"></div></div></div>
    </div>
</section>

<section id="reportSection" class="hidden pixel-section pb-24 bg-slate-50 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800">
    <div class="border-b border-slate-200 dark:border-slate-800 py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row md:items-end md:justify-between gap-6">
            <div><p class="text-xs font-mono uppercase tracking-widest text-primary-600 mb-2" id="reportBadge">Explore The Unknown</p><h1 class="pixel-heading text-3xl sm:text-4xl font-bold text-primary-600 tracking-tight uppercase" id="reportTitle"></h1><p class="text-md text-slate-500 dark:text-slate-400 font-light mt-2 max-w-2xl" id="reportSubtitle"></p><p class="theme-situation mt-4 max-w-3xl" id="themeSituation"></p></div>
            <div class="flex items-center gap-2 border border-primary-200 dark:border-primary-900/40 rounded bg-primary-50/20 dark:bg-primary-950/20 px-3 py-1.5 text-xs font-mono text-primary-600"><svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg><span id="reportLocation"></span></div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 space-y-8">
        <div id="reportSoul" class="report-section bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-8 sm:p-10 shadow-sm"><div class="flex items-center gap-2 mb-6 border-b border-slate-100 dark:border-slate-800/60 pb-4"><h2 class="text-xs font-mono uppercase tracking-wider text-primary-600">Contextual Narrative</h2></div><div class="prose prose-slate dark:prose-invert max-w-none text-base leading-relaxed font-light text-slate-600 dark:text-slate-300 space-y-4" id="soulContent"></div></div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
            <div id="reportHistory" class="report-section delay-200 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-8 shadow-sm h-full"><div class="flex items-center gap-2 mb-6 border-b border-slate-100 dark:border-slate-800/60 pb-4"><h2 class="text-xs font-mono uppercase tracking-wider text-primary-600">Chronological Milestones</h2></div><div class="space-y-6 relative border-l border-slate-200 dark:border-slate-800 pl-4 ml-2 animate-fade-in-up" id="historyContent"></div></div>
            <div id="reportMustVisit" class="report-section delay-300 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-8 shadow-sm h-full"><div class="flex items-center gap-2 mb-6 border-b border-slate-100 dark:border-slate-800/60 pb-4"><h2 class="text-xs font-mono uppercase tracking-wider text-primary-600">Curated Points of Interest</h2></div><div class="space-y-4" id="mustVisitContent"></div></div>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
            <div id="reportFlavors" class="report-section delay-400 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-8 shadow-sm h-full"><div class="flex items-center gap-2 mb-6 border-b border-slate-100 dark:border-slate-800/60 pb-4"><h2 class="text-xs font-mono uppercase tracking-wider text-primary-600">Cultural & Flavor Profiles</h2></div><div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="flavorsContent"></div></div>
            <div id="reportTips" class="report-section delay-500 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-8 shadow-sm h-full"><div class="flex items-center gap-2 mb-6 border-b border-slate-100 dark:border-slate-800/60 pb-4"><h2 class="text-xs font-mono uppercase tracking-wider text-primary-600">Operational Guidelines</h2></div><div class="space-y-3.5" id="tipsContent"></div></div>
        </div>
        <div id="reportDisasters" class="report-section delay-600 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-8 shadow-sm"><div class="flex items-center gap-2 mb-6 border-b border-slate-100 dark:border-slate-800/60 pb-4"><h2 class="text-xs font-mono uppercase tracking-wider text-primary-600">Historical Accidents & Disasters</h2></div><div class="grid grid-cols-1 lg:grid-cols-2 gap-4" id="disastersContent"></div></div>
        <div id="reportFacts" class="report-section delay-700 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl p-8 shadow-sm"><div class="flex items-center gap-2 mb-6 border-b border-slate-100 dark:border-slate-800/60 pb-4"><h2 class="text-xs font-mono uppercase tracking-wider text-primary-600">Trivia Matrix</h2></div><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="factsContent"></div></div>
    </div>

    <div id="reportActions" class="report-section delay-700 flex flex-wrap items-center justify-center gap-4 pt-12 pb-4 border-t border-slate-200 dark:border-slate-800 mt-12">
        <button id="regenerateBtn" type="button" class="pixel-button inline-flex items-center gap-2 px-5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-xs font-mono uppercase tracking-wider rounded transition-all duration-200 cursor-pointer">Regenerate</button>
        <button id="exportPdfBtn" type="button" class="pixel-button secondary inline-flex items-center gap-2 px-5 py-2.5 border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 text-xs font-mono uppercase tracking-wider rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-all duration-200 cursor-pointer">Download PDF</button>
        <button id="newReportBtn" type="button" class="pixel-button secondary inline-flex items-center gap-2 px-5 py-2.5 border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 text-xs font-mono uppercase tracking-wider rounded hover:bg-slate-100 dark:hover:bg-slate-800 transition-all duration-200 cursor-pointer">Reset Dossier</button>
    </div>
</section>

    <footer class="pixel-footer py-10 px-3 text-center text-xs font-mono uppercase tracking-wider text-slate-400 dark:text-slate-600 border-t border-slate-200/60 dark:border-slate-800/60 bg-white dark:bg-slate-950">
    <p>PlaceHack Engine &middot; Created by Mighty &middot; &copy; <%= year %></p>
</footer>

<%- include('partials/layout-end') %>