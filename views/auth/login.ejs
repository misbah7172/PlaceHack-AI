<%- include('../partials/layout-start') %>
<section class="relative min-h-[90vh] flex items-center justify-center py-20 px-4 bg-slate-50 dark:bg-slate-950">
    <div class="relative z-10 w-full max-w-sm">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded p-8 sm:p-10 shadow-sm">
            <div class="text-center mb-8 pb-6 border-b border-slate-100 dark:border-slate-800">
                <h2 class="text-xl font-bold uppercase tracking-wider text-slate-900 dark:text-white">Sign In</h2>
                <p class="text-slate-500 dark:text-slate-400 mt-2 text-xs font-mono uppercase tracking-wide">Enter system portal</p>
            </div>

            <% if (errors.length) { %>
                <div class="mb-6 p-4 rounded bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-450 text-xs font-mono"><ul class="list-disc list-inside space-y-1"><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul></div>
            <% } %>

            <form action="/login" method="POST" class="space-y-5">
                <div><label for="email" class="block text-xs font-mono uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-2">Email Address</label><input type="email" name="email" id="email" value="<%= old.email || '' %>" required autofocus class="w-full px-3.5 py-2.5 rounded border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all" placeholder="email@domain.com"></div>
                <div><label for="password" class="block text-xs font-mono uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-2">Password</label><input type="password" name="password" id="password" required class="w-full px-3.5 py-2.5 rounded border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-sm text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all" placeholder="Password"></div>
                <label class="flex items-center gap-2 cursor-pointer select-none"><input type="checkbox" name="remember" class="w-4 h-4 rounded border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 text-primary-600 focus:ring-primary-500/30"><span class="text-xs font-mono uppercase text-slate-500">Remember credentials</span></label>
                <button type="submit" class="w-full py-3 bg-primary-600 hover:bg-primary-700 text-white text-xs font-mono uppercase tracking-widest rounded transition-all duration-200 cursor-pointer">Authenticate</button>
            </form>

            <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-800 text-center"><p class="text-xs font-mono uppercase tracking-wider text-slate-500">No account?<a href="/register" class="font-bold text-primary-600 hover:underline ml-1">Create one</a></p></div>
        </div>
    </div>
</section>
<%- include('../partials/layout-end') %>