APP_NAME="PlaceHack AI"
NODE_ENV=development
PORT=3000
SESSION_SECRET=change-me

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=log

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_COMPLETION_TOKENS=8000
OPENAI_REASONING_EFFORT=low
OPENAI_REQUEST_TIMEOUT=120

VITE_APP_NAME="${APP_NAME}"
